{
  "name": "polypong",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/server/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:arm64": "bun build src/server/main.ts --compile --target=bun-darwin-arm64 --outfile dist/polypong-arm64",
    "build:x64": "bun build src/server/main.ts --compile --target=bun-darwin-x64 --outfile dist/polypong-x64"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
